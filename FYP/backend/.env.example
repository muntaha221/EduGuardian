# Copy this file to .env and fill in real values. .env is git-ignored.

# MongoDB URI. Use the Atlas format in Render; local development can use localhost.
# Atlas example: mongodb+srv://<db_user>:<db_password>@<cluster-host>/FYP?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/FYP
PORT=8080
# Set to "false" to disable all outgoing email (e.g. local dev without SMTP access).
EMAIL_ENABLED=true

# Gmail SMTP defaults. Use a Gmail Account > Security > App Passwords value for
# EMAIL_PASS (your normal Gmail password will NOT work with SMTP).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-school-account@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM_NAME=EduGuardian

# IANA timezone used to schedule the daily overdue-fee / late-homework email scan.
CRON_TIMEZONE=Asia/Karachi

# Public URL of the app, used for "view voucher" links in fee emails.
APP_URL=http://localhost:8080

# School name printed on generated fee vouchers.
SCHOOL_NAME=EduGuardian School
